PORT=4000
JWT_SECRET=change_this_secret_in_production

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=hotel_booking
# Hosted database (Supabase / Neon): paste its connection string here instead of the DB_* values above.
# Use the Supabase *session pooler* string (port 5432) — not the IPv6-only direct host, and not the
# transaction pooler on 6543 (breaks the row locks used for bookings). Leave the password out of the
# URL and put it in DATABASE_PASSWORD so special characters don't need escaping.
# DATABASE_URL=postgresql://postgres.<project-ref>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_PASSWORD=
# true for hosted PostgreSQL (encrypted connections); leave false locally
DB_SSL=false
# Supabase signs with its own CA: Dashboard → Database settings → SSL → download certificate, save it here.
# DB_SSL_CA_FILE=certs/supabase-ca.crt
# Supabase free plan allows ~60 connections; two servers × 10 fits comfortably.
# DB_POOL_MAX=10

# Razorpay (Dashboard -> Account & Settings -> API Keys). Use rzp_test_* keys in development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks; point it at <public server url>/api/checkout/webhooks/razorpay
# and subscribe to payment.captured, payment.failed, refund.processed, refund.failed.
RAZORPAY_WEBHOOK_SECRET=
# Minutes a pending booking holds inventory while the guest completes payment.
BOOKING_HOLD_MINUTES=15

# Public website address used in email links. Emails themselves are sent by admin/server.
SITE_URL=http://localhost:3000

# Credentials for the demo users created by `knex seed:run` (dev only).
SEED_GUEST_EMAIL=
SEED_GUEST_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Comma-separated frontend origins allowed to call this API when hosted. Unset = any origin (local dev).
# CORS_ORIGINS=https://stayfarer.vercel.app
